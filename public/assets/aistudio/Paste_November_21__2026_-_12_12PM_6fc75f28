  <script>
    const slides = {
      en: [
        { icon: 'notifications_active', bg: 'bg-light-warning-container text-light-on-warning-container', title: 'Stay informed with disaster alerts.', desc: 'Receive verified IMD, NDMA, and local civic warnings for floods, cyclones, heatwaves, and earthquakes in real time.' },
        { icon: 'night_shelter', bg: 'bg-light-success-container text-light-on-success-container', title: 'Know your nearest safe shelter.', desc: 'Locate open relief camps, hospitals, and safe evacuation routes near you — even when mobile data is slow.' },
        { icon: 'medical_services', bg: 'bg-light-secondary-container text-light-on-secondary-container', title: 'Prepare your emergency kit.', desc: 'Track water, medicines, Aadhaar documents, and flashlight readiness with a guided family checklist.' },
        { icon: 'family_restroom', bg: 'bg-light-primary-container text-light-on-primary-container', title: 'Keep your family safe.', desc: 'Share live check-ins with one tap using “I am Safe” or “Need Help” and set a shared family meeting point.' },
        { icon: 'sos', bg: 'bg-light-error-container text-light-on-error-container', title: 'Get help when every second matters.', desc: 'Reach 112 National Emergency Services and alert your trusted contacts with your exact GPS coordinates.' }
      ],
      hi: [
        { icon: 'notifications_active', bg: 'bg-light-warning-container text-light-on-warning-container', title: 'आपदा अलर्ट से समय पर सतर्क रहें।', desc: 'बाढ़, चक्रवात, लू और भूकंप के लिए IMD और NDMA की सत्यापित चेतावनियाँ तुरंत प्राप्त करें।' },
        { icon: 'night_shelter', bg: 'bg-light-success-container text-light-on-success-container', title: 'अपना निकटतम सुरक्षित आश्रय जानें।', desc: 'आस-पास के राहत शिविर, अस्पताल और सुरक्षित निकासी मार्ग आसानी से खोजें।' },
        { icon: 'medical_services', bg: 'bg-light-secondary-container text-light-on-secondary-container', title: 'अपनी आपातकालीन किट तैयार रखें।', desc: 'पीने का पानी, दवाइयाँ, जरूरी दस्तावेज़ और टॉर्च की तैयारी चेकलिस्ट से ट्रैक करें।' },
        { icon: 'family_restroom', bg: 'bg-light-primary-container text-light-on-primary-container', title: 'अपने परिवार को सुरक्षित रखें।', desc: 'एक टैप में “मैं सुरक्षित हूँ” संदेश भेजें और परिवार के मिलने का सुरक्षित स्थान तय करें।' },
        { icon: 'sos', bg: 'bg-light-error-container text-light-on-error-container', title: 'हर सेकंड कीमती है — तुरंत मदद पाएं।', desc: '112 राष्ट्रीय आपातकालीन सेवा से जुड़ें और अपने सटीक GPS स्थान के साथ मदद बुलाएं।' }
      ]
    };

    let idx = 0;
    let lang = 'en';

    function render() {
      const s = slides[lang][idx];
      document.getElementById('slide-icon').textContent = s.icon;
      document.getElementById('slide-icon-wrap').className = 'w-32 h-32 rounded-full flex items-center justify-center ' + s.bg;
      document.getElementById('slide-step-label').textContent = lang === 'en' ? `Step ${idx + 1} of 5` : `चरण ${idx + 1} / 5`;
      document.getElementById('slide-title').textContent = s.title;
      document.getElementById('slide-desc').textContent = s.desc;
      document.getElementById('skip-link').textContent = lang === 'en' ? 'Skip' : 'छोड़ें';
      document.getElementById('next-label').textContent = lang === 'en' ? 'Next' : 'आगे';
      document.getElementById('start-label').textContent = lang === 'en' ? 'Get Started' : 'शुरू करें';

      document.querySelectorAll('.ob-dot').forEach((d, i) => {
        d.className = i === idx
          ? 'ob-dot w-6 h-2 rounded-full bg-light-primary'
          : 'ob-dot w-2 h-2 rounded-full bg-light-outline-variant';
      });

      const isLast = idx === 4;
      document.getElementById('next-btn').classList.toggle('hidden', isLast);
      document.getElementById('get-started-btn').classList.toggle('hidden', !isLast);
    }

    function nextSlide() {
      if (idx < 4) { idx++; render(); }
    }
    function goSlide(i) { idx = i; render(); }
    function setLang(l) {
      lang = l;
      document.getElementById('ob-en').className = l === 'en'
        ? 'px-gutter-md py-gutter-xs rounded-full bg-light-primary text-light-on-primary font-label text-label-sm'
        : 'px-gutter-md py-gutter-xs rounded-full text-light-on-surface-variant font-label text-label-sm';
      document.getElementById('ob-hi').className = l === 'hi'
        ? 'px-gutter-md py-gutter-xs rounded-full bg-light-primary text-light-on-primary font-label text-label-sm'
        : 'px-gutter-md py-gutter-xs rounded-full text-light-on-surface-variant font-label text-label-sm';
      render();
    }
  </script>


