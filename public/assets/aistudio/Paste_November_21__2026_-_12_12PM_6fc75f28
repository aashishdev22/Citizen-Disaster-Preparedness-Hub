    function updateScore() {
      const cbs = document.querySelectorAll('.kit-cb');
      const checked = Array.from(cbs).filter(c => c.checked).length;
      const pct = Math.round((checked / cbs.length) * 100);
      document.getElementById('score-pct').textContent = pct + '%';
      document.getElementById('score-sub').textContent = `${checked} of ${cbs.length} key items packed across 6 categories.`;
      const offset = 213.6 - (213.6 * pct / 100);
      document.getElementById('score-ring').setAttribute('stroke-dashoffset', offset.toFixed(1));
    }

    function resetChecklist() {
      document.querySelectorAll('.kit-cb').forEach(c => { c.checked = false; });
      updateScore();
    }
