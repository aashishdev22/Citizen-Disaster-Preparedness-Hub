<body class="bg-light-background text-light-on-surface font-body antialiased">
  <div class="min-h-[884px] max-w-[430px] mx-auto bg-light-surface flex flex-col justify-between px-gutter-xl py-gutter-xl" data-stitch-vh="min-h-[884px]===min-h-screen">

