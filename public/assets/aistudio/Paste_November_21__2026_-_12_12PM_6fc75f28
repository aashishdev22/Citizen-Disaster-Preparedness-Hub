  <script>
    function togglePass() {
      const inp = document.getElementById('login-pass');
      const eye = document.getElementById('pass-eye');
      const isPass = inp.type === 'password';
      inp.type = isPass ? 'text' : 'password';
      eye.textContent = isPass ? 'visibility_off' : 'visibility';
    }

    function handleLogin(e) {
      e.preventDefault();
      const id = document.getElementById('login-id').value.trim();
      const pass = document.getElementById('login-pass').value.trim();
      const fb = document.getElementById('auth-feedback');
      const btn = document.getElementById('login-btn');

      if (!id || !pass) {
        fb.className = 'p-gutter-md rounded bg-light-error-container text-light-on-error-container text-body-md';
        fb.textContent = 'Please enter both your mobile number/email and password.';
        fb.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      btn.innerHTML = '<span class="font-label text-label-lg">Signing in...</span>';
      fb.className = 'p-gutter-md rounded bg-light-success-container text-light-on-success-container text-body-md';
      fb.textContent = 'Verified! Redirecting to Home Dashboard...';
      fb.classList.remove('hidden');

      setTimeout(() => {
        window.location.href = '../home-dashboard/HomeDashboard.html';
      }, 800);
    }
  </script>


