      <!-- BEFORE PHASE -->
      <section id="phase-before" class="flex flex-col gap-gutter-md">
        <div class="bg-light-surface rounded-md border border-light-outline-variant p-gutter-lg flex flex-col gap-gutter-md">
          <h2 data-design-text-token="title-md" class="font-title text-title-md text-light-on-surface">Preparation Steps</h2>
          <div class="flex items-start gap-gutter-md">
            <span class="w-8 h-8 rounded-full bg-light-primary-container text-light-primary inline-flex items-center justify-center shrink-0 font-label text-label-md">1</span>
            <p data-design-text-token="body-md" class="font-body text-body-md text-light-on-surface">Seal Aadhaar, property papers, and medical prescriptions in a waterproof zip pouch inside your emergency kit.</p>
          </div>
          <div class="flex items-start gap-gutter-md">
            <span class="w-8 h-8 rounded-full bg-light-primary-container text-light-primary inline-flex items-center justify-center shrink-0 font-label text-label-md">2</span>
            <p data-design-text-token="body-md" class="font-body text-body-md text-light-on-surface">Charge power banks and keep 3 days of drinking water (3L per person/day) and dry snacks ready.</p>
          </div>
          <div class="flex items-start gap-gutter-md">
            <span class="w-8 h-8 rounded-full bg-light-primary-container text-light-primary inline-flex items-center justify-center shrink-0 font-label text-label-md">3</span>
            <p data-design-text-token="body-md" class="font-body text-body-md text-light-on-surface">Identify the nearest elevated BMC/municipal relief shelter and agree on a family meeting point.</p>
          </div>
        </div>
      </section>

