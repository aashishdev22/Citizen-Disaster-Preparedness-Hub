      <div class="flex items-center gap-gutter-xs bg-light-surface-container rounded-full p-gutter-xs">
        <button type="button" id="ob-en" onclick="setLang(&#39;en&#39;)" class="px-gutter-md py-gutter-xs rounded-full bg-light-primary text-light-on-primary font-label text-label-sm">EN</button>
        <button type="button" id="ob-hi" onclick="setLang(&#39;hi&#39;)" class="px-gutter-md py-gutter-xs rounded-full text-light-on-surface-variant font-label text-label-sm">हिन्दी</button>
      </div>
      <a href="../login/Login.html" id="skip-link" class="min-h-[44px] px-gutter-md inline-flex items-center font-label text-label-lg text-light-on-surface-variant hover:text-light-primary">Skip</a>
    </header>

    <!-- Slide Content -->
    <main class="flex-1 flex flex-col items-center justify-center text-center gap-gutter-xl py-gutter-xl">
      <div id="slide-icon-wrap" class="w-32 h-32 rounded-full bg-light-primary-container text-light-primary flex items-center justify-center">
        <span id="slide-icon" class="material-symbols-outlined text-[64px]" style="font-variation-settings: &#39;FILL&#39; 1;" aria-hidden="true">notifications_active</span>
      </div>

      <div class="flex flex-col gap-gutter-md max-w-[320px]">
        <span id="slide-step-label" data-design-text-token="label-md" class="font-label text-label-md text-light-secondary">Step 1 of 5</span>
        <h1 id="slide-title" data-design-text-token="headline-md" class="font-headline text-headline-md text-light-on-surface text-balance">Stay informed with disaster alerts.</h1>
        <p id="slide-desc" data-design-text-token="body-lg" class="font-body text-body-lg text-light-on-surface-variant text-pretty">Receive verified IMD, NDMA, and local civic warnings for floods, cyclones, heatwaves, and earthquakes in real time.</p>
      </div>

      <!-- Step Dots -->
      <div class="flex items-center gap-gutter-sm" role="tablist" aria-label="Onboarding steps">
        <button type="button" onclick="goSlide(0)" class="ob-dot w-6 h-2 rounded-full bg-light-primary" aria-label="Step 1"></button>
        <button type="button" onclick="goSlide(1)" class="ob-dot w-2 h-2 rounded-full bg-light-outline-variant" aria-label="Step 2"></button>
        <button type="button" onclick="goSlide(2)" class="ob-dot w-2 h-2 rounded-full bg-light-outline-variant" aria-label="Step 3"></button>
        <button type="button" onclick="goSlide(3)" class="ob-dot w-2 h-2 rounded-full bg-light-outline-variant" aria-label="Step 4"></button>
        <button type="button" onclick="goSlide(4)" class="ob-dot w-2 h-2 rounded-full bg-light-outline-variant" aria-label="Step 5"></button>
      </div>
    </main>

    <!-- Bottom Action Bar -->
    <footer class="flex flex-col gap-gutter-sm">
      <button type="button" id="next-btn" onclick="nextSlide()" class="w-full min-h-[48px] px-gutter-lg py-gutter-md rounded-md bg-light-primary text-light-on-primary font-label text-label-lg inline-flex items-center justify-center gap-gutter-sm hover:opacity-95">
        <span id="next-label" data-design-text-token="label-lg">Next</span>
        <span class="material-symbols-outlined text-[20px]" aria-hidden="true">arrow_forward</span>
      </button>
