        <button type="button" onclick="setSosState(&#39;ready&#39;)" class="w-full min-h-[44px] px-gutter-lg py-gutter-sm rounded bg-light-primary text-light-on-primary font-label text-label-lg">
          <span data-design-text-token="label-lg">Return to SOS Screen</span>
        </button>
