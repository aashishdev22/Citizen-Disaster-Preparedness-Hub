  <script>
    let countdownTimer = null;
    let selectedEmergencyType = 'Medical Assistance';

    function selectType(btn, label) {
      selectedEmergencyType = label;
      document.querySelectorAll('.sos-type-btn').forEach(el => {
        el.classList.remove('border-2', 'border-light-error', 'bg-light-error-container/40', 'text-light-on-error-container');
        el.classList.add('border', 'border-light-outline-variant', 'bg-light-surface', 'text-light-on-surface');
      });
      btn.classList.remove('border', 'border-light-outline-variant', 'bg-light-surface', 'text-light-on-surface');
      btn.classList.add('border-2', 'border-light-error', 'bg-light-error-container/40', 'text-light-on-error-container');
    }

    function setSosState(state) {
      clearInterval(countdownTimer);
      ['ready', 'countdown', 'active', 'canceled'].forEach(s => {
        document.getElementById('sos-state-' + s).classList.toggle('hidden', s !== state);
        const tab = document.getElementById('tab-' + s);
        if (s === state) {
          tab.classList.add('bg-light-surface', 'text-light-primary', 'shadow-sm');
          tab.classList.remove('text-light-on-surface-variant');
        } else {
          tab.classList.remove('bg-light-surface', 'text-light-primary', 'shadow-sm');
          tab.classList.add('text-light-on-surface-variant');
        }
      });
      if (state === 'countdown') {
        document.getElementById('selected-type-label').textContent = selectedEmergencyType;
        document.getElementById('countdown-num').textContent = '3';
      }
    }

    function startCountdown() {
      setSosState('countdown');
      let sec = 3;
      countdownTimer = setInterval(() => {
        sec--;
        if (sec <= 0) {
          clearInterval(countdownTimer);
          setSosState('active');
        } else {
          document.getElementById('countdown-num').textContent = String(sec);
        }
      }, 1000);
    }

    function cancelCountdown() {
      clearInterval(countdownTimer);
      setSosState('canceled');
    }
  </script>


