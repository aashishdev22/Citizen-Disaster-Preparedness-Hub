    function filterAlerts(cat, btn) {
      document.querySelectorAll('.filter-chip').forEach(c => {
        c.classList.remove('bg-light-primary', 'text-light-on-primary');
        c.classList.add('bg-light-surface', 'border', 'border-light-outline-variant', 'text-light-on-surface');
      });
      btn.classList.add('bg-light-primary', 'text-light-on-primary');
      btn.classList.remove('bg-light-surface', 'border', 'border-light-outline-variant', 'text-light-on-surface');

      document.querySelectorAll('.alert-item').forEach(item => {
        if (cat === 'all' || item.dataset.category.includes(cat)) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    }

    function openAlertDetail(title, badge, source, area, body) {
      document.getElementById('detail-title').textContent = title;
      document.getElementById('detail-badge').textContent = badge;
      document.getElementById('detail-source').textContent = source;
      document.getElementById('detail-area').textContent = area;
      document.getElementById('detail-body').textContent = body;
      document.getElementById('alert-detail-modal').classList.remove('hidden');
    }
