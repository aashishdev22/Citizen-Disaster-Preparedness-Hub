<body class="bg-light-background text-light-on-surface font-body antialiased">
  <div class="min-h-[884px] max-w-[430px] mx-auto bg-light-background flex flex-col pb-24 relative" data-stitch-vh="min-h-[884px]===min-h-screen">

    <!-- Contextual Header -->
    <header class="sticky top-0 z-30 bg-light-surface border-b border-light-outline-variant px-gutter-lg py-gutter-md flex items-center justify-between gap-gutter-sm">
      <div class="flex items-center gap-gutter-sm">
        <a href="../home-dashboard/HomeDashboard.html" aria-label="Back to Home" class="w-11 h-11 rounded-full hover:bg-light-surface-container-low inline-flex items-center justify-center text-light-on-surface">
          <span class="material-symbols-outlined text-[24px]" aria-hidden="true">arrow_back</span>
        </a>
        <div>
          <h1 data-design-text-token="headline-sm" class="font-headline text-headline-sm text-light-on-surface">Evacuation Planner</h1>
          <p data-design-text-token="label-sm" class="font-label text-label-sm text-light-success">Saved Offline • Dadar Plan</p>
        </div>
      </div>
      <button type="button" onclick="document.getElementById(&#39;plan-modal&#39;).classList.remove(&#39;hidden&#39;)" class="min-h-[36px] px-gutter-md py-gutter-xs rounded bg-light-primary text-light-on-primary font-label text-label-md">Edit Plan</button>
    </header>

    <main class="flex-1 px-gutter-lg py-gutter-lg flex flex-col gap-gutter-lg">

      <!-- Origin -> Destination Summary -->
      <section class="bg-light-surface rounded-md border border-light-outline-variant p-gutter-lg shadow-sm flex flex-col gap-gutter-sm">
        <div class="flex items-center gap-gutter-md">
          <span class="w-3 h-3 rounded-full bg-light-primary shrink-0"></span>
          <div class="min-w-0">
            <span data-design-text-token="label-sm" class="font-label text-label-sm text-light-on-surface-variant block">From Home Location</span>
            <span id="plan-origin" data-design-text-token="title-md" class="font-title text-title-md text-light-on-surface">Shivaji Park, Dadar West</span>
          </div>
        </div>
        <div class="ml-1.5 h-4 border-l-2 border-dashed border-light-outline-variant"></div>
        <div class="flex items-center gap-gutter-md">
          <span class="w-3 h-3 rounded-full bg-light-success shrink-0"></span>
          <div class="min-w-0">
            <span data-design-text-token="label-sm" class="font-label text-label-sm text-light-on-surface-variant block">Destination Relief Shelter</span>
            <span id="plan-dest" data-design-text-token="title-md" class="font-title text-title-md text-light-on-surface">BMC Dadar Relief Shelter</span>
          </div>
        </div>
        <div class="pt-gutter-sm border-t border-light-outline-variant flex items-center justify-between">
          <span data-design-text-token="label-md" class="font-label text-label-md text-light-on-surface-variant">Meeting Point: <span id="plan-meet" class="text-light-on-surface">Shivaji Park Gate 2</span></span>
          <span data-design-text-token="label-sm" class="font-label text-label-sm text-light-secondary">4 Members</span>
        </div>
      </section>

      <!-- Road Blockage / Flood Warning -->
      <div role="alert" class="p-gutter-md rounded-md bg-light-warning-container text-light-on-warning-container flex items-start gap-gutter-sm">
        <span class="material-symbols-outlined text-[20px] shrink-0 mt-0.5" aria-hidden="true">water</span>
        <p data-design-text-token="body-md" class="font-body text-body-md">Hindmata Flyover &amp; Dr. Ambedkar Rd underpass have active waterlogging. Use elevated Gokhale Road route.</p>
      </div>

      <!-- Recommended Route -->
      <section class="flex flex-col gap-gutter-sm">
        <h2 data-design-text-token="headline-sm" class="font-headline text-headline-sm text-light-on-surface">Evacuation Routes</h2>

        <article class="bg-light-surface rounded-md border-2 border-light-success p-gutter-lg shadow-sm flex flex-col gap-gutter-sm">
          <div class="flex items-center justify-between gap-gutter-sm">
            <span class="px-gutter-sm py-gutter-xs rounded-full bg-light-success-container text-light-on-success-container font-label text-label-sm">Recommended • Clear</span>
            <span data-design-text-token="label-md" class="font-label text-label-md text-light-on-surface tabular-nums">1.4 km • 6 min</span>
          </div>
          <h3 data-design-text-token="title-md" class="font-title text-title-md text-light-on-surface">Via Gokhale Road North</h3>
          <p data-design-text-token="body-md" class="font-body text-body-md text-light-on-surface-variant">High elevation, zero reported blockages, street lighting active.</p>
          <a href="../safe-shelter-map/SafeShelterMap.html" class="min-h-[44px] px-gutter-md py-gutter-sm rounded bg-light-success text-light-on-success font-label text-label-lg inline-flex items-center justify-center gap-gutter-xs">
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">directions</span>
            <span data-design-text-token="label-lg">Start Safe Route</span>
          </a>
        </article>

        <!-- Alternative Route -->
        <article class="bg-light-surface rounded-md border border-light-outline-variant p-gutter-lg flex flex-col gap-gutter-sm">
          <div class="flex items-center justify-between gap-gutter-sm">
            <span class="px-gutter-sm py-gutter-xs rounded-full bg-light-warning-container text-light-on-warning-container font-label text-label-sm">Caution • Minor Water</span>
            <span data-design-text-token="label-md" class="font-label text-label-md text-light-on-surface-variant tabular-nums">2.2 km • 12 min</span>
          </div>
          <h3 data-design-text-token="title-md" class="font-title text-title-md text-light-on-surface">Via Tilak Bridge &amp; Dadar TT</h3>
          <p data-design-text-token="body-md" class="font-body text-body-md text-light-on-surface-variant">Slow traffic near Dadar East approach due to waterlogging.</p>
        </article>
      </section>

      <!-- Important Evacuation Instructions -->
      <section class="bg-light-surface rounded-md border border-light-outline-variant p-gutter-lg flex flex-col gap-gutter-xs">
        <h2 data-design-text-token="title-md" class="font-title text-title-md text-light-on-surface">Before Leaving Home</h2>
        <ul class="list-disc pl-5 text-body-md text-light-on-surface-variant flex flex-col gap-gutter-xs">
          <li>Grab your Go-Bag and waterproof Aadhaar/medical pouch.</li>
          <li>Turn off main MCB electricity switch and LPG cylinder regulator.</li>
          <li>Check in on Family Safety once you reach the meeting point.</li>
        </ul>
      </section>

    </main>

    <!-- Edit Plan Modal -->
    <div id="plan-modal" class="hidden fixed inset-0 z-50 bg-light-on-surface/50 flex items-end justify-center p-gutter-lg">
      <div class="bg-light-surface rounded-lg w-full max-w-[390px] p-gutter-xl flex flex-col gap-gutter-md shadow-xl">
        <div class="flex items-center justify-between">
          <h2 data-design-text-token="headline-sm" class="font-headline text-headline-sm text-light-on-surface">Update Evacuation Plan</h2>
          <button type="button" onclick="document.getElementById(&#39;plan-modal&#39;).classList.add(&#39;hidden&#39;)" aria-label="Close" class="w-10 h-10 rounded-full hover:bg-light-surface-container inline-flex items-center justify-center">
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">close</span>
          </button>
        </div>
        <label class="flex flex-col gap-gutter-xs">
          <span data-design-text-token="label-md" class="font-label text-label-md">Family Meeting Point</span>
          <input id="inp-meet" type="text" value="Shivaji Park Gate 2" class="min-h-[44px] px-gutter-md py-gutter-sm rounded border border-light-outline-variant text-body-md focus:border-light-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-light-primary">
        </label>
        <label class="flex flex-col gap-gutter-xs">
          <span data-design-text-token="label-md" class="font-label text-label-md">Primary Shelter</span>
          <select id="inp-shelter" class="min-h-[44px] px-gutter-md py-gutter-sm rounded border border-light-outline-variant text-body-md focus:border-light-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-light-primary">
            <option>BMC Dadar Relief Shelter</option>
            <option>Matunga Community Hall Camp</option>
            <option>Worli Sea Face High School</option>
          </select>
        </label>
        <button type="button" onclick="savePlan()" class="min-h-[48px] rounded bg-light-primary text-light-on-primary font-label text-label-lg">Save Plan Offline</button>
      </div>
    </div>

    <!-- Floating SOS Button -->
    <a href="../emergency-sos/EmergencySOS.html" aria-label="Emergency SOS" class="fixed bottom-6 right-4 z-40 w-14 h-14 rounded-full bg-light-error text-light-on-error shadow-lg hover:opacity-95 inline-flex flex-col items-center justify-center border-2 border-light-surface">
      <span data-design-text-token="label-lg" class="font-label text-label-lg leading-none">SOS</span>
    </a>
  </div>

  <script>
    function savePlan() {
      document.getElementById('plan-meet').textContent = document.getElementById('inp-meet').value;
      document.getElementById('plan-dest').textContent = document.getElementById('inp-shelter').value;
      document.getElementById('plan-modal').classList.add('hidden');
    }
  </script>


</body></html>

