        <span class="material-symbols-outlined text-[24px]" aria-hidden="true">arrow_back</span>
      </a>
      <div>
        <h1 data-design-text-token="headline-sm" class="font-headline text-headline-sm text-light-on-surface">Incident Reporting</h1>
        <p data-design-text-token="label-sm" class="font-label text-label-sm text-light-on-surface-variant">Report hazards to BMC &amp; SDMA</p>
      </div>
    </header>

    <main class="flex-1 px-gutter-lg py-gutter-lg flex flex-col gap-gutter-lg">

      <!-- View Tabs: Report Form / My Reports -->
      <div class="grid grid-cols-2 gap-gutter-xs bg-light-surface-container p-gutter-xs rounded-md" role="tablist">
        <button type="button" id="tab-submit" onclick="switchTab(&#39;submit&#39;)" class="min-h-[40px] rounded bg-light-surface text-light-primary font-label text-label-md shadow-sm">Report Incident</button>
        <button type="button" id="tab-reports" onclick="switchTab(&#39;reports&#39;)" class="min-h-[40px] rounded text-light-on-surface-variant font-label text-label-md">My Reports (2)</button>
      </div>

      <!-- TAB 1: SUBMIT INCIDENT FORM -->
      <section id="view-submit" class="flex flex-col gap-gutter-md">
        <form onsubmit="submitReport(event)" class="bg-light-surface rounded-md border border-light-outline-variant p-gutter-lg shadow-sm flex flex-col gap-gutter-md">
          <label class="flex flex-col gap-gutter-xs">
            <span data-design-text-token="label-md" class="font-label text-label-md text-light-on-surface">Incident Type</span>
            <select id="inc-type" class="min-h-[44px] w-full px-gutter-md py-gutter-sm rounded border border-light-outline-variant bg-light-surface text-body-md focus:border-light-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-light-primary">
              <option>Flooded Road / Waterlogging</option>
              <option>Fallen Tree / Road Blockage</option>
              <option>Electric Hazard / Fallen Wire</option>
              <option>Fire</option>
              <option>Damaged Building / Landslide</option>
              <option>Person Needing Rescue</option>
            </select>
          </label>

